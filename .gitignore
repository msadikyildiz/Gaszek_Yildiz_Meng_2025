# Ignore folders
archive/
cache/
.venv/
*.pyc

# macOS finder metadata
.DS_Store

# Devin notebook scratch outputs
src/graph_analysis/_generated/

# Figure composition scratch
figures/_compose/

# Figure 6 DCA notebook run scratch (regenerates on running the notebook)
src/evolutionary_statistics/figures/

# Large regenerable intermediate (rebuild via analysis/s16_replicate_reproducibility/analysis.py)
analysis/s16_replicate_reproducibility/data/per_genotype_replicate_stats.csv

# Validation pipeline regenerable outputs (rebuild via validation/src/run_all.py):
# processed parquet/CSV intermediates + figures. Regeneration verified from a clean clone.
# Note: run validation/src/run_all.py BEFORE the S7/S8 generators (si_figures/s07_s08_ic50/,
# source_data/scripts/build_s7s8_source_data.py), which read validation/src/processed/.
validation/src/processed/
validation/figures/

# Per-module analysis figure scratch: published Supplementary panels now write
# directly to figures/supplementary/ (tracked); everything left in a module's
# own figures/ (top-level or nested, e.g. library_invariance/figures/) is
# secondary/diagnostic output that regenerates on rerun of that module's
# analysis.py, so it is not committed.
analysis/**/figures/

# Same convention for the si_figures/ backfill imports (S2, S3): each
# module's own figures/ is regenerable scratch (rerun the notebook /
# analysis.py); the published panel lives in figures/supplementary/.
si_figures/**/figures/

# Source Data per-figure CSVs: regenerable scratch (rebuild via the scripts in
# source_data/scripts/); the assembled source_data.xlsx is built separately
# and is not committed until the Fig 6 / S18 contributor sheets land.
source_data/derived/
